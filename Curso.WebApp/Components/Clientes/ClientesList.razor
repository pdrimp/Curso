@page "/Clientes"
@inject IClienteService ClienteService
@inject ITipoClienteService TipoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Clientes</h3>

<div class="mb-3 d-flex justify-content-between">
    <div>
        <button class="btn btn-primary" @onclick="CreateNew">Nuevo cliente</button>
    </div>
    <div>
        <select class="form-select" style="width:200px" @onchange="OnFilterTipoChanged">
            <option value="">Todos los tipos</option>
            @if (tipos != null)
            {
                @foreach (var t in tipos)
                {
                    <option value="@t.Id">@t.Descripcion</option>
                }
            }
        </select>
    </div>
</div>

@if (items == null)
{
    <p>Cargando...</p>
}
else if (!items.Any())
{
    <p>No hay clientes registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Tipo</th>
                <th style="width:220px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in PagedItems)
            {
                <tr>
                    <td>@it.Nombre</td>
                    <td>@it.Correo</td>
                    <td>@it.TipoClienteDescripcion</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => Edit(it.Id)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(it.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")"><a class="page-link" href="#" @onclick="Previous">Anterior</a></li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(currentPage == p ? "active" : "")"><a class="page-link" href="#" @onclick="() => GoTo(p)">@p</a></li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")"><a class="page-link" href="#" @onclick="Next">Siguiente</a></li>
            </ul>
        </nav>
    }
}

@code {
    private List<ClienteResponse> items;
    private List<TipoClienteResponse> tipos;
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => (int)Math.Ceiling((filtered?.Count ?? 0) / (double)pageSize);
    private List<ClienteResponse> filtered;

    private IEnumerable<ClienteResponse> PagedItems => (filtered ?? Enumerable.Empty<ClienteResponse>()).Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        tipos = await TipoService.GetAllTiposClientesAsync();
        items = await ClienteService.GetAllClientesAsync();
        filtered = items.ToList();
    }

    private void CreateNew() => Nav.NavigateTo("/Clientes/nuevo");
    private void Edit(Guid id) => Nav.NavigateTo($"/Clientes/editar/{id}");
    private async Task Delete(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Eliminar el cliente?")) return;
        await ClienteService.DeleteClienteAsync(id);
        items = await ClienteService.GetAllClientesAsync();
        filtered = items.ToList();
        StateHasChanged();
    }

    private void OnFilterTipoChanged(ChangeEventArgs e)
    {
        var val = e?.Value?.ToString();
        if (string.IsNullOrEmpty(val)) filtered = items.ToList();
        else
        {
            if (Guid.TryParse(val, out var gid)) filtered = items.Where(x => x.TipoClienteId == gid).ToList();
        }
        currentPage = 1;
    }

    // pagination helpers
    private void Previous()
    {
        if (currentPage > 1) currentPage--;
    }
    private void Next()
    {
        if (currentPage < totalPages) currentPage++;
    }
    private void GoTo(int p) => currentPage = p;
}
